QUOTE_TIMEOUT_S=3.5
QUOTE_MAX_ATTEMPTS=4
QUOTE_BUDGET_S=15

# LLM (Gemini via agno)
GOOGLE_API_KEY=
# Modelo: escolhido no Studio (aba Config) e gravado em config/settings.json.
AGNO_TELEMETRY=false

# Evolution API (WhatsApp) — só para o adaptador channels/evolution.py
EVOLUTION_URL=http://localhost:8080
